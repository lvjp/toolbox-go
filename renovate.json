{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices",
        ":disableRateLimiting"
    ],
    "postUpdateOptions": [
        "gomodTidy",
        "gomodUpdateImportPaths"
    ],
    "dependencyDashboard": false,
    "rebaseWhen": "behind-base-branch",
    "timezone": "Europe/Paris",
    "semanticCommits": "enabled",
    "semanticCommitScope": "",
    "commitMessageTopic": "{{depName}}",
    "customManagers": [
        {
            "customType": "regex",
            "description": "GitHub Actions workflow",
            "managerFilePatterns": [
                ".github/workflows/**"
            ],
            "matchStrings": [
                "(?<currentValue>[^\\s]+) # renovate: datasource=(?<datasource>.+) depName=(?<depName>.+)"
            ]
        }
    ],
    "packageRules": [
        {
            "groupName": "Go toolchain",
            "matchDepNames": [
                "go",
                "golang"
            ]
        },
        {
            "description": "Module dependencies are build changes",
            "matchManagers": [
                "gomod"
            ],
            "semanticCommitType": "build"
        },
        {
            "description": "Actions and CI tools are ci changes",
            "matchFileNames": [
                ".github/workflows/**"
            ],
            "semanticCommitType": "ci"
        }
    ]
}